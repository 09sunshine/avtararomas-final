# Server Configuration
PORT=4001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Reverse proxy hop count (1 for Render/Vercel/Nginx, 0 for direct local development)
TRUST_PROXY_HOPS=0

# Supabase (Database & Auth Admin)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Notifications
# Recommended for Render: Brevo REST API (Uses HTTPS port 443 - NEVER blocked by Render firewall)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
SMTP_FROM_EMAIL=avtar.aromas@gmail.com
ADMIN_EMAIL=avtar.aromas@gmail.com

# Optional SMTP fallback (e.g. for local development)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_EMAIL=your_brevo_smtp_login@example.com
SMTP_APP_PASSWORD=your_brevo_smtp_master_key
